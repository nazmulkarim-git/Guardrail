{
  "name": "@forsig/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for creating and resolving Forsig human-approval escalations.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "node --check dist/index.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "forsig",
    "ai-agents",
    "human-in-the-loop",
    "approval",
    "escalation",
    "agent-safety"
  ],
  "homepage": "https://www.forsig.com",
  "bugs": {
    "url": "https://www.forsig.com/contact"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
